FROM python:3.14.4-slim@sha256:2ca02f32b4d9d893863367ce07ec1972819f476dd38d8612f2a9cb6a41cbb727
WORKDIR /app
# Install-only network access. Runtime verification uses Docker --network none.
RUN pip install --no-cache-dir uv==0.11.8
COPY pyproject.toml uv.lock README.md .python-version ./
RUN uv sync --frozen --no-dev --no-install-project --python /usr/local/bin/python
COPY src ./src
COPY scripts/offline_check.py ./offline_check.py
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
CMD ["/app/.venv/bin/python", "offline_check.py"]

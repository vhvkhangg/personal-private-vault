{
  "repository-safety": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/repository_safety.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

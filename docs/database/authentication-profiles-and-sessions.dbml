// Additive BF26-DP-A relations. Frozen Schema v1 remains unchanged.
// Physical authority: backend/src/main/resources/db/migration/V29__authentication_profiles_and_sessions.sql

Table ppv_public_login_credential {
  owner_id smallint [pk, not null, note: 'CHECK owner_id = 1; FK app_users(id)']
  password_hash varchar(255) [null, note: 'Standard delegated password hash (PBKDF2 default) for PUBLIC profile; NULL when unconfigured']
  credential_epoch bigint [not null, default: 0, note: 'Monotonic epoch; 0 when unconfigured, >= 1 when configured']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
  Stores the optional secondary password hash and credential epoch for the fixed PUBLIC profile.
  Single row for owner_id = 1.
  CHECK constraint enforces (password_hash IS NULL AND credential_epoch = 0) OR
                           (password_hash IS NOT NULL AND length(password_hash) > 0 AND credential_epoch > 0).
  Excluded from Portability JSONL snapshots.
  '''
}

Table ppv_login_sessions {
  id uuid [pk, not null, note: 'Session identifier (sid in JWT access token)']
  owner_id smallint [not null, note: 'CHECK owner_id = 1; FK app_users(id)']
  active_profile varchar(7) [not null, note: 'CHECK IN (PUBLIC, PRIVATE)']
  generation bigint [not null, note: 'CHECK generation > 0; increments on profile transition (elevation/downgrade), preserved on refresh rotation']
  public_credential_epoch bigint [null, note: 'Snapshot of credential_epoch when session is/was ever PUBLIC; NULL for pure PRIVATE']
  current_refresh_token_id bigint [not null, note: 'Composite circular deferred FK fk_session_current_refresh to refresh_tokens(id, session_id, user_id, profile, session_generation)']
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'CHECK expires_at > created_at; rolling 30-day session lifetime']
  revoked_at timestamptz [null, note: 'Set on session revocation; admission denied once set']

  indexes {
    (id, owner_id) [unique, name: 'uq_login_session_owner']
  }

  Note: '''
  Persisted session authority tracking active profile, generation, and epoch binding.
  Joined in single-SQL admission query on every dispatch.
  Circular composite FK fk_session_current_refresh to refresh_tokens(id, session_id, user_id, profile, session_generation)
  is DEFERRABLE INITIALLY DEFERRED, mutually bound with fk_refresh_session_owner.
  Excluded from Portability JSONL snapshots.
  '''
}

// Alteration to existing Schema v1 table: refresh_tokens
// Column additions:
// - session_id uuid [null, composite FK fk_refresh_session_owner to ppv_login_sessions(id, owner_id) DEFERRABLE INITIALLY DEFERRED]
// - profile varchar(7) [null, CHECK IN (PUBLIC, PRIVATE)]
// - session_generation bigint [null, CHECK session_generation > 0]
// Constraint ck_refresh_profile_binding enforces:
// (session_id IS NULL AND profile IS NULL AND session_generation IS NULL AND revoked_at IS NOT NULL) OR
// (session_id IS NOT NULL AND profile IS NOT NULL AND session_generation IS NOT NULL AND profile IN ('PUBLIC','PRIVATE') AND session_generation > 0)
// Constraint uq_refresh_session_authority: UNIQUE (id, session_id, user_id, profile, session_generation)

Ref fk_refresh_session_owner: refresh_tokens.(session_id, user_id) > ppv_login_sessions.(id, owner_id) [note: 'DEFERRABLE INITIALLY DEFERRED composite foreign key']
Ref fk_session_current_refresh: ppv_login_sessions.(current_refresh_token_id, id, owner_id, active_profile, generation) > refresh_tokens.(id, session_id, user_id, profile, session_generation) [note: 'DEFERRABLE INITIALLY DEFERRED composite circular foreign key']

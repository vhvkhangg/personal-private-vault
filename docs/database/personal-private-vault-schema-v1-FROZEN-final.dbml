//////////////////////////////////////////////////////////////

// PERSONAL PRIVATE VAULT

// Database Schema v1 - FROZEN BASELINE
// Final ERD review revision: v1.3
// Logical schema frozen before backend implementation

// PostgreSQL

//////////////////////////////////////////////////////////////


//////////////////////////////////////////////////////////////

// ENUMS

//////////////////////////////////////////////////////////////


Enum vault_entry_type {

  FICTION

  FILM

  PERSON

  FILM_CREDIT

  IMAGE

  ALBUM

  BRAND

  LOCATION

  STUDY

  INFORMATION

  VOCABULARY

  MUSIC

  SHOPPING

  SOFTWARE

  NOTE

  SAVED_RESOURCE

  EXTERNAL_ACCOUNT

}


Enum rating_grade {

  D

  C

  B

  A

  S

}


Enum gender {

  MALE

  FEMALE

}


Enum consumption_status {

  UNCONSUMED

  BEING_CONSUMED

  CONSUMED

}


Enum progress_status {

  ONGOING

  COMPLETED

  SUSPENDED

}


Enum fiction_format {

  NOVEL

  COMIC

}


Enum film_format {

  MOVIE

  SERIES

}


Enum film_production_style {

  LIVE_ACTION

  ANIMATION

}


Enum person_role {

  ACTOR

  SINGER

  DIRECTOR

  AUTHOR

  ARTIST

}


Enum film_credit_role {

  MAIN

  SUPPORTING

  CAMEO

  GUEST

  VOICE

}


Enum study_type {

  COURSE

  BOOK

  GITHUB_REPOSITORY

  WEBSITE

  YOUTUBE_CHANNEL

}


Enum study_status {

  PLANNED

  IN_PROGRESS

  PAUSED

  COMPLETED

}


Enum information_type {

  FINANCE

  TECHNOLOGY

  HEALTH

  OTHER

}


Enum vocabulary_learning_status {

  NEW

  LEARNING

  REVIEW

  MASTERED

}


Enum srs_review_response {

  AGAIN

  HARD

  GOOD

  EASY

}


Enum music_version {

  ORIGINAL

  COVER

  PARODY

  MIX

}


Enum music_credit_role {

  SINGER

  ARTIST

}


Enum shopping_status {

  WISHLIST

  PURCHASED

}


Enum software_type {

  APPLICATION

  EXTENSION

}

Enum dining_service_style {

  A_LA_CARTE

  BUFFET

}


Enum platform_kind {

  SOCIAL

  MEDIA

  MARKETPLACE

  GAME

  DEVELOPER

  OPERATING_SYSTEM

  BROWSER

  IDE

  WEB

  OTHER

}


Enum external_account_ownership {

  OWNED

  TRACKED

}


Enum external_account_type {

  SOCIAL

  GAME

  YOUTUBE_CHANNEL

  OTHER

}


Enum follower_status {

  CURRENT_FOLLOWER

  NO_LONGER_FOLLOWING

  NOT_FOLLOWING

  UNKNOWN

}


Enum relationship_source {

  MANUAL

  SNAPSHOT

  IMPORT

  API

}


Enum follow_status {

  FOLLOWED

  NOT_FOLLOWED

  UNKNOWN

}


Enum follower_snapshot_source {

  MANUAL

  IMPORT

  API

}


Enum feed_source_type {

  GITHUB_TRENDING

  HACKER_NEWS

  REDDIT

  RSS

  WEBSITE

}


Enum saved_resource_kind {

  ARTICLE

  REPOSITORY

  SOCIAL_POST

  WEB_PAGE

  OTHER

}


Enum import_format {

  CSV

  JSON

  MARKDOWN

}


Enum import_target_type {

  STUDY

  INFORMATION

  VOCABULARY

  NOTE

}


Enum import_job_status {

  CREATED

  PARSED

  VALIDATED

  IMPORTED

  FAILED

  CANCELLED

}


Enum import_item_status {

  VALID

  DUPLICATE

  INVALID

  IMPORTED

  UPDATED

  SKIPPED

}


Enum wallet_type {

  CASH

  BANK_ACCOUNT

  CARD

  E_WALLET

  OTHER

}


Enum financial_transaction_type {

  INCOME

  EXPENSE

  TRANSFER

}


Enum financial_transaction_status {

  PENDING

  POSTED

  CANCELLED

}


Enum transaction_category_kind {

  INCOME

  EXPENSE

  BOTH

}


Enum recurring_posting_mode {

  AUTO_POST

  REQUIRE_CONFIRMATION

}


Enum recurrence_frequency {

  DAILY

  WEEKLY

  MONTHLY

  YEARLY

}


Enum day_of_week {

  MONDAY

  TUESDAY

  WEDNESDAY

  THURSDAY

  FRIDAY

  SATURDAY

  SUNDAY

}


Enum billing_cycle {

  WEEKLY

  MONTHLY

  YEARLY

  CUSTOM

}


//////////////////////////////////////////////////////////////

// AUTHENTICATION + SETTINGS

//////////////////////////////////////////////////////////////


Table app_users {

  id smallint [pk, default: 1]


  email varchar(320) [not null, unique]

  username varchar(100) [not null, unique]


  password_hash varchar(255) [not null]

  pin_hash varchar(255) [not null]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]

  checks {
    `id = 1` [name: 'chk_app_users_singleton_id']
  }


  Note: '''

  This application permanently supports one user only.


  No registration endpoint.

  Initial account is created using one-time bootstrap setup.

  PIN is exactly 6 digits before hashing.

  '''

}


Table refresh_tokens {

  id bigint [pk, increment]


  user_id smallint [not null, ref: > app_users.id]


  token_hash varchar(255) [not null, unique]


  expires_at timestamptz [not null]

  revoked_at timestamptz


  replaced_by_token_id bigint [unique, ref: -? refresh_tokens.id]


  user_agent text

  ip_address inet


  created_at timestamptz [not null, default: `now()`]


  indexes {

    user_id

    expires_at

  }

}


Table app_settings {

  id smallint [pk, default: 1]


  timezone varchar(64) [not null, default: 'Asia/Ho_Chi_Minh']


  default_currency_code varchar(3) [not null, ref: > currencies.code]


  pagination_size int [not null, default: 20]


  private_mode_auto_lock_minutes int [not null, default: 5]


  backup_enabled boolean [not null, default: false]

  backup_interval_hours int


  updated_at timestamptz [not null, default: `now()`]

  checks {
    `id = 1` [name: 'chk_app_settings_singleton_id']
    `pagination_size > 0` [name: 'chk_app_settings_pagination_size']
    `private_mode_auto_lock_minutes > 0` [name: 'chk_app_settings_auto_lock']
    `backup_interval_hours IS NULL OR backup_interval_hours > 0` [name: 'chk_app_settings_backup_interval']
    `NOT backup_enabled OR backup_interval_hours IS NOT NULL` [name: 'chk_app_settings_backup_enabled_interval']
  }


  Note: '''

  Expected to contain exactly one row.


  UI/theme configuration is intentionally excluded until frontend phase.

  '''

}


//////////////////////////////////////////////////////////////

// REFERENCE DATA

//////////////////////////////////////////////////////////////


Table countries {

  code varchar(2) [pk]


  name_en varchar(150) [not null]

  name_vi varchar(150)


  Note: 'ISO 3166-1 alpha-2.'

}


Table languages {

  code varchar(10) [pk]


  name_en varchar(100) [not null]

  name_vi varchar(100)

}


Table currencies {

  code varchar(3) [pk]


  name varchar(100) [not null]

  symbol varchar(16)


  decimal_places int [not null, default: 2]


  Note: 'ISO 4217 where applicable.'

}


Table platforms {

  id bigint [pk, increment]


  name varchar(100) [not null, unique]


  kind platform_kind [not null]


  url varchar(2048)


  created_at timestamptz [not null, default: `now()`]

}


//////////////////////////////////////////////////////////////

// GLOBAL VAULT

//////////////////////////////////////////////////////////////


Table vault_entries {

  id bigint [pk, increment]


  entry_type vault_entry_type [not null]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  deleted_at timestamptz


  indexes {

    entry_type

    deleted_at

  }


  Note: '''

  Common identity for content entities.


  deleted_at implements Recycle Bin.

  Null deleted_at means active.


  Trash is retained indefinitely until the user permanently deletes it.

  '''

}


Table favorites {

  vault_entry_id bigint [pk, ref: - vault_entries.id]


  created_at timestamptz [not null, default: `now()`]

}


Table ratings {

  vault_entry_id bigint [pk, ref: - vault_entries.id]


  grade rating_grade [not null]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]

}


Table tags {

  id bigint [pk, increment]


  name varchar(100) [not null, unique]


  created_at timestamptz [not null, default: `now()`]

}


Table vault_entry_tags {

  vault_entry_id bigint [not null, ref: > vault_entries.id]

  tag_id bigint [not null, ref: > tags.id]


  created_at timestamptz [not null, default: `now()`]


  indexes {

    (vault_entry_id, tag_id) [pk]

    tag_id

  }


  Note: '''

  film_credit is intentionally not taggable.

  Allowed entry types will be validated by the application layer.

  '''

}


//////////////////////////////////////////////////////////////

// PEOPLE / CREATORS

//////////////////////////////////////////////////////////////


Table persons {

  id bigint [pk, ref: - vault_entries.id]


  name varchar(255) [not null]


  avatar_url varchar(2048)


  gender gender


  birth_date date


  height_cm numeric(6,2)

  weight_kg numeric(6,2)


  nationality_code varchar(2) [ref: >? countries.code]


  notes text

  checks {
    `height_cm IS NULL OR height_cm > 0` [name: 'chk_person_height']
    `weight_kg IS NULL OR weight_kg > 0` [name: 'chk_person_weight']
  }

}


Table person_roles {

  person_id bigint [not null, ref: > persons.id]


  role person_role [not null]


  indexes {

    (person_id, role) [pk]

  }

}


Table creator_groups {

  id bigint [pk, increment]


  name varchar(255) [not null, unique]


  description text


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]

}


Table creator_group_members {

  creator_group_id bigint [not null, ref: > creator_groups.id]

  person_id bigint [not null, ref: > persons.id]


  indexes {

    (creator_group_id, person_id) [pk]

  }

}


//////////////////////////////////////////////////////////////

// FICTION + FILM TAXONOMIES

//////////////////////////////////////////////////////////////


Table fiction_genres {

  id bigint [pk, increment]


  name varchar(150) [not null, unique]


  description text

}


Table film_genres {

  id bigint [pk, increment]


  name varchar(150) [not null, unique]


  description text


  Note: '''

  Genre values are expected to use Vietnamese / Sino-Vietnamese names.

  '''

}


Table story_archetypes {

  id bigint [pk, increment]


  name varchar(150) [not null, unique]


  description text


  Note: '''

  Represents "lưu phái".


  Examples:

  Ngự thú lưu

  Vô địch lưu

  Hệ thống lưu

  Vô hạn lưu

  Phản phái lưu

  Sau màn lưu

  Xây dựng thế lực lưu

  '''

}


Table world_settings {

  id bigint [pk, increment]


  name varchar(150) [not null, unique]


  description text


  Note: '''

  Examples:

  Cao Võ Thế Giới

  Tây Phương Kỳ Huyễn

  Đông Phương Huyền Huyễn

  Đô Thị Sinh Hoạt

  Đô Thị Dị Năng

  Thanh Xuân Vườn Trường

  Mạt Thế Nguy Cơ

  '''

}


//////////////////////////////////////////////////////////////

// FICTION

//////////////////////////////////////////////////////////////


Table fictions {

  id bigint [pk, ref: - vault_entries.id]


  title varchar(500) [not null]

  original_title varchar(500)


  nationality_code varchar(2) [ref: >? countries.code]


  poster_url varchar(2048)


  format fiction_format [not null]


  is_nsfw boolean [not null, default: false]


  genre_id bigint [not null, ref: > fiction_genres.id]


  author_person_id bigint [ref: >? persons.id]

  author_group_id bigint [ref: >? creator_groups.id]


  description text


  total_chapters int


  progress_status progress_status [not null, default: 'ONGOING']

  consumption_status consumption_status [not null, default: 'UNCONSUMED']


  current_progress_text varchar(255)


  review text


  indexes {

    title

    original_title

    genre_id

  }


  checks {
    `total_chapters IS NULL OR total_chapters >= 0` [name: 'chk_fiction_total_chapters']
    `((author_person_id IS NOT NULL AND author_group_id IS NULL) OR (author_person_id IS NULL AND author_group_id IS NOT NULL))` [name: 'chk_fiction_author_source']
  }

  Note: '''

  Exactly one author source should normally be present:

  author_person_id XOR author_group_id.


  current_progress_text is intentionally flexible.

  Examples:

  15

  15.5

  Extra 2

  Chương đặc biệt

  '''

}


Table fiction_story_archetypes {

  fiction_id bigint [not null, ref: > fictions.id]

  story_archetype_id bigint [not null, ref: > story_archetypes.id]


  indexes {

    (fiction_id, story_archetype_id) [pk]

  }

}


Table fiction_world_settings {

  fiction_id bigint [not null, ref: > fictions.id]

  world_setting_id bigint [not null, ref: > world_settings.id]


  indexes {

    (fiction_id, world_setting_id) [pk]

  }

}


Table fiction_links {

  id bigint [pk, increment]


  fiction_id bigint [not null, ref: > fictions.id]


  language_code varchar(10) [ref: >? languages.code]


  link_type varchar(50) [not null]


  label varchar(255)


  url varchar(2048) [not null]


  is_primary boolean [not null, default: false]


  created_at timestamptz [not null, default: `now()`]


  indexes {

    fiction_id

  }


  Note: '''

  link_type examples:

  TRANSLATION

  CONVERT

  ORIGINAL

  OTHER


  Multiple links of the same language/type are allowed.

  '''

}


//////////////////////////////////////////////////////////////

// FILM

//////////////////////////////////////////////////////////////


Table films {

  id bigint [pk, ref: - vault_entries.id]


  title varchar(500) [not null]

  original_title varchar(500)


  nationality_code varchar(2) [ref: >? countries.code]


  poster_url varchar(2048)


  format film_format [not null]


  production_style film_production_style [not null]


  is_nsfw boolean [not null, default: false]


  director_person_id bigint [ref: >? persons.id]


  description text


  total_episodes int


  progress_status progress_status [not null, default: 'ONGOING']

  consumption_status consumption_status [not null, default: 'UNCONSUMED']


  current_progress_text varchar(255)


  review text


  indexes {

    title

    original_title

  }

  checks {
    `total_episodes IS NULL OR total_episodes >= 0` [name: 'chk_film_total_episodes']
  }

}


Table film_genre_assignments {

  film_id bigint [not null, ref: > films.id]

  genre_id bigint [not null, ref: > film_genres.id]


  indexes {

    (film_id, genre_id) [pk]

    genre_id

  }

}


Table film_story_archetypes {

  film_id bigint [not null, ref: > films.id]

  story_archetype_id bigint [not null, ref: > story_archetypes.id]


  indexes {

    (film_id, story_archetype_id) [pk]

  }

}


Table film_world_settings {

  film_id bigint [not null, ref: > films.id]

  world_setting_id bigint [not null, ref: > world_settings.id]


  indexes {

    (film_id, world_setting_id) [pk]

  }

}


Table film_links {

  id bigint [pk, increment]


  film_id bigint [not null, ref: > films.id]


  language_code varchar(10) [ref: >? languages.code]


  label varchar(255)


  url varchar(2048) [not null]


  is_primary boolean [not null, default: false]


  created_at timestamptz [not null, default: `now()`]


  indexes {

    film_id

  }

}


Table film_credits {

  id bigint [pk, ref: - vault_entries.id]


  film_id bigint [not null, ref: > films.id]

  person_id bigint [not null, ref: > persons.id]


  role film_credit_role [not null]


  character_name varchar(255)


  note text


  indexes {

    film_id

    person_id

    (film_id, person_id, character_name)

  }


  Note: '''

  Replaces the original film_actor join table.


  film_credit:

  - may be favorited

  - has no rating

  - has no tags


  Multiple credits for the same person/film are allowed

  when character_name differs.

  '''

}


//////////////////////////////////////////////////////////////

// MEDIA

//////////////////////////////////////////////////////////////


Table albums {

  id bigint [pk, ref: - vault_entries.id]


  title varchar(500) [not null]


  description text


  Note: '''

  image_count is intentionally not stored.

  Frontend/API computes COUNT(images).

  '''

}


Table images {

  id bigint [pk, ref: - vault_entries.id]


  album_id bigint [ref: >? albums.id]


  title varchar(500)


  image_type varchar(100)


  object_key varchar(1024) [not null, unique]


  source_url varchar(2048)


  mime_type varchar(100)


  size_bytes bigint


  width_px int

  height_px int


  checksum_sha256 varchar(64) [unique]


  captured_at timestamptz


  location_text varchar(500)


  indexes {

    album_id

    captured_at

    checksum_sha256

  }


  checks {
    `size_bytes IS NULL OR size_bytes >= 0` [name: 'chk_image_size']
    `width_px IS NULL OR width_px > 0` [name: 'chk_image_width']
    `height_px IS NULL OR height_px > 0` [name: 'chk_image_height']
  }

  Note: '''

  The binary file is not stored in PostgreSQL.


  object_key points to an S3-compatible object storage abstraction.


  During development only small test files should be stored locally.

  '''

}


//////////////////////////////////////////////////////////////

// LOCATION

//////////////////////////////////////////////////////////////


Table brands {

  id bigint [pk, ref: - vault_entries.id]


  name varchar(255) [not null]


  logo_url varchar(2048)


  nationality_code varchar(2) [ref: >? countries.code]


  description text


  min_price numeric(19,4)

  max_price numeric(19,4)

  currency_code varchar(3) [ref: >? currencies.code]


  review text


  indexes {

    name

  }


  checks {
    `min_price IS NULL OR min_price >= 0` [name: 'chk_brands_min_price']
    `max_price IS NULL OR max_price >= 0` [name: 'chk_brands_max_price']
    `min_price IS NULL OR max_price IS NULL OR min_price <= max_price` [name: 'chk_brands_price_range']
    `currency_code IS NOT NULL OR (min_price IS NULL AND max_price IS NULL)` [name: 'chk_brands_price_currency']
  }

  Note: '''

  Represents chains/brands such as restaurant or cafe brands.


  Rating may be attached using global ratings.

  Physical branches are represented by locations.

  '''

}


Table location_categories {

  id bigint [pk, increment]


  name varchar(150) [not null, unique]


  description text


  Note: '''

  Examples:

  Restaurant

  Cafe

  Tourist Attraction

  Landmark

  Scenic Area

  '''

}


Table addresses {

  id bigint [pk, increment]


  label varchar(255)


  address_type varchar(100)


  country_code varchar(2) [not null, ref: > countries.code]


  administrative_area varchar(255)


  locality varchar(255)


  sublocality varchar(255)


  street_address varchar(500)


  postal_code varchar(32)


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]

}


Table locations {

  id bigint [pk, ref: - vault_entries.id]


  brand_id bigint [ref: >? brands.id]


  address_id bigint [not null, ref: > addresses.id]


  name varchar(500) [not null]


  image_url varchar(2048)


  description text


  phone varchar(64)

  website_url varchar(2048)

  business_hours_known boolean [not null, default: false]


  min_price numeric(19,4)

  max_price numeric(19,4)

  currency_code varchar(3) [ref: >? currencies.code]


  review text


  indexes {

    brand_id

    name

  }

  checks {
    `min_price IS NULL OR min_price >= 0` [name: 'chk_locations_min_price']
    `max_price IS NULL OR max_price >= 0` [name: 'chk_locations_max_price']
    `min_price IS NULL OR max_price IS NULL OR min_price <= max_price` [name: 'chk_locations_price_range']
    `currency_code IS NOT NULL OR (min_price IS NULL AND max_price IS NULL)` [name: 'chk_locations_price_currency']
  }

}


Table location_category_assignments {

  location_id bigint [not null, ref: > locations.id]

  category_id bigint [not null, ref: > location_categories.id]


  indexes {

    (location_id, category_id) [pk]

    category_id

  }

}


Table location_dining_service_styles {

  location_id bigint [not null, ref: > locations.id]

  service_style dining_service_style [not null]

  indexes {
    (location_id, service_style) [pk]
  }

  Note: '''
  Used when the Location represents a food/beverage venue.

  A location may support both A_LA_CARTE and BUFFET.
  '''
}


Table location_business_hours {

  id bigint [pk, increment]


  location_id bigint [not null, ref: > locations.id]


  day_of_week day_of_week [not null]


  sequence int [not null, default: 1]


  open_time time [not null]

  close_time time [not null]


  indexes {

    (location_id, day_of_week, sequence) [unique]

  }


  checks {
    `sequence > 0` [name: 'chk_location_business_hours_sequence']
  }

  Note: '''

  When locations.business_hours_known = true, zero rows for a weekday means closed.

  When locations.business_hours_known = false, business hours are unknown/not entered yet.


  Multiple rows per weekday allow split schedules.

  close_time may be earlier than open_time for an overnight interval.

  Example:

  06:00-11:00

  16:00-22:00

  '''

}


//////////////////////////////////////////////////////////////

// STUDY

//////////////////////////////////////////////////////////////


Table study_items {

  id bigint [pk, ref: - vault_entries.id]


  title varchar(500) [not null]


  poster_url varchar(2048)


  type study_type [not null]

  site_domain varchar(255)

  youtube_channel_account_id bigint [unique, ref: -? external_accounts.id]


  author_person_id bigint [ref: >? persons.id]

  author_group_id bigint [ref: >? creator_groups.id]


  published_date date


  price_amount numeric(19,4)

  currency_code varchar(3) [ref: >? currencies.code]


  description text


  url varchar(2048)


  review text


  learning_status study_status [not null, default: 'PLANNED']


  progress_percent numeric(5,2)


  current_progress_text varchar(500)


  indexes {

    title

    type

    learning_status

    site_domain

    youtube_channel_account_id

  }

  checks {
    `progress_percent IS NULL OR (progress_percent >= 0 AND progress_percent <= 100)` [name: 'chk_study_progress_percent']
    `NOT (author_person_id IS NOT NULL AND author_group_id IS NOT NULL)` [name: 'chk_study_author_source']
    `price_amount IS NULL OR price_amount >= 0` [name: 'chk_study_price']
    `currency_code IS NOT NULL OR price_amount IS NULL` [name: 'chk_study_currency']
    `(type = 'WEBSITE' AND site_domain IS NOT NULL AND url IS NOT NULL) OR (type <> 'WEBSITE' AND site_domain IS NULL)` [name: 'chk_study_website_fields']
    `(type = 'YOUTUBE_CHANNEL' AND youtube_channel_account_id IS NOT NULL) OR (type <> 'YOUTUBE_CHANNEL' AND youtube_channel_account_id IS NULL)` [name: 'chk_study_youtube_fields']
  }

  Note: '''
  Type-specific fields:

  WEBSITE:
  - url is the canonical/primary URL
  - site_domain stores the canonical hostname for filtering/search

  YOUTUBE_CHANNEL:
  - youtube_channel_account_id links to an ExternalAccount whose
    account_type must be YOUTUBE_CHANNEL and platform must be YouTube.
  - channel handle is stored in external_accounts.username
  - YouTube channel ID is stored in external_accounts.external_id
  - channel display name/avatar/banner/URL are stored in external_accounts

  COURSE / BOOK / GITHUB_REPOSITORY normally leave the two
  type-specific fields null.

  Cross-table type validation is enforced in the application/Flyway layer.
  '''
}


//////////////////////////////////////////////////////////////

// KNOWLEDGE / INFORMATION

//////////////////////////////////////////////////////////////


Table information_items {

  id bigint [pk, ref: - vault_entries.id]


  title varchar(500) [not null]


  type information_type [not null]


  description text


  content_markdown text


  example text


  source_name varchar(500)

  source_url varchar(2048)


  indexes {

    title

    type

  }

}


//////////////////////////////////////////////////////////////

// VOCABULARY + SRS

//////////////////////////////////////////////////////////////


Table vocabulary_items {

  id bigint [pk, ref: - vault_entries.id]


  word varchar(500) [not null]


  language_code varchar(10) [not null, ref: > languages.code]


  meaning text [not null]


  example text


  pronunciation varchar(500)


  ipa varchar(255)


  part_of_speech varchar(100)


  source_name varchar(500)

  source_url varchar(2048)


  learning_status vocabulary_learning_status [not null, default: 'NEW']


  next_review_at timestamptz


  interval_days int [not null, default: 0]


  ease_factor numeric(5,2) [not null, default: 2.50]


  repetition_count int [not null, default: 0]


  lapse_count int [not null, default: 0]


  indexes {

    word

    language_code

    learning_status

    next_review_at

  }

  checks {
    `interval_days >= 0` [name: 'chk_vocabulary_interval_days']
    `ease_factor > 0` [name: 'chk_vocabulary_ease_factor']
    `repetition_count >= 0` [name: 'chk_vocabulary_repetition_count']
    `lapse_count >= 0` [name: 'chk_vocabulary_lapse_count']
  }

}


Table vocabulary_reviews {

  id bigint [pk, increment]


  vocabulary_id bigint [not null, ref: > vocabulary_items.id]


  response srs_review_response [not null]


  reviewed_at timestamptz [not null, default: `now()`]


  previous_interval_days int

  new_interval_days int


  previous_ease_factor numeric(5,2)

  new_ease_factor numeric(5,2)


  next_review_at timestamptz


  indexes {

    vocabulary_id

    reviewed_at

  }

  checks {
    `previous_interval_days IS NULL OR previous_interval_days >= 0` [name: 'chk_vocab_review_previous_interval']
    `new_interval_days IS NULL OR new_interval_days >= 0` [name: 'chk_vocab_review_new_interval']
    `previous_ease_factor IS NULL OR previous_ease_factor > 0` [name: 'chk_vocab_review_previous_ease']
    `new_ease_factor IS NULL OR new_ease_factor > 0` [name: 'chk_vocab_review_new_ease']
  }

}


//////////////////////////////////////////////////////////////

// NOTES / OBSIDIAN

//////////////////////////////////////////////////////////////


Table notes {

  id bigint [pk, ref: - vault_entries.id]


  title varchar(500) [not null]


  content_markdown text [not null]


  summary text


  source_name varchar(500)

  source_url varchar(2048)


  imported_file_name varchar(500)

  imported_file_hash varchar(64) [unique]


  frontmatter jsonb


  indexes {

    title

    imported_file_hash

  }


  Note: '''

  Markdown content is preserved rather than normalized.


  Supported Obsidian syntax may include:

  YAML frontmatter

  [[wikilinks]]

  #tags

  ![[embeds]]

  Obsidian callouts


  Unknown YAML frontmatter keys are preserved in frontmatter JSONB.

  '''

}


//////////////////////////////////////////////////////////////

// MUSIC

//////////////////////////////////////////////////////////////


Table music_tracks {

  id bigint [pk, ref: - vault_entries.id]


  title varchar(500) [not null]


  version music_version [not null, default: 'ORIGINAL']


  platform_id bigint [ref: >? platforms.id]


  url varchar(2048)


  indexes {

    title

    platform_id

  }

}


Table music_track_people {

  music_id bigint [not null, ref: > music_tracks.id]

  person_id bigint [not null, ref: > persons.id]


  role music_credit_role [not null]


  indexes {

    (music_id, person_id, role) [pk]

  }

}


//////////////////////////////////////////////////////////////

// SHOPPING

//////////////////////////////////////////////////////////////


Table shopping_items {

  id bigint [pk, ref: - vault_entries.id]


  name varchar(500) [not null]


  avatar_url varchar(2048)


  description text


  price_amount numeric(19,4)

  currency_code varchar(3) [ref: >? currencies.code]


  platform_id bigint [ref: >? platforms.id]


  status shopping_status [not null, default: 'WISHLIST']


  url varchar(2048)


  purchased_at timestamptz


  indexes {

    name

    status

  }

  checks {
    `price_amount IS NULL OR price_amount >= 0` [name: 'chk_shopping_price']
    `currency_code IS NOT NULL OR price_amount IS NULL` [name: 'chk_shopping_currency']
    `status = 'PURCHASED' OR purchased_at IS NULL` [name: 'chk_shopping_purchased_at']
  }

}


//////////////////////////////////////////////////////////////

// SOFTWARE + EXTENSIONS

//////////////////////////////////////////////////////////////


Table software_items {

  id bigint [pk, ref: - vault_entries.id]


  name varchar(500) [not null]


  type software_type [not null]


  logo_url varchar(2048)


  description text


  price_amount numeric(19,4)

  currency_code varchar(3) [ref: >? currencies.code]


  url varchar(2048)


  review text


  indexes {

    name

    type

  }

  checks {
    `price_amount IS NULL OR price_amount >= 0` [name: 'chk_software_price']
    `currency_code IS NOT NULL OR price_amount IS NULL` [name: 'chk_software_currency']
  }

}


Table software_item_platforms {

  software_id bigint [not null, ref: > software_items.id]

  platform_id bigint [not null, ref: > platforms.id]


  indexes {

    (software_id, platform_id) [pk]

  }

}


//////////////////////////////////////////////////////////////

// EXTERNAL / SOCIAL / GAME ACCOUNTS

//////////////////////////////////////////////////////////////


Table external_accounts {

  id bigint [pk, ref: - vault_entries.id]


  platform_id bigint [not null, ref: > platforms.id]


  ownership external_account_ownership [not null]


  account_type external_account_type [not null]


  username varchar(255)


  external_id varchar(255)


  display_name varchar(500)

  avatar_url varchar(2048)

  banner_url varchar(2048)

  profile_description text


  owner_name varchar(500)


  url varchar(2048)


  notes text


  indexes {

    platform_id

    username

    external_id

    (platform_id, external_id) [unique]

  }

  checks {
    `username IS NOT NULL OR external_id IS NOT NULL OR url IS NOT NULL` [name: 'chk_external_account_identifier']
  }


  Note: '''

  YouTube channel mapping:
  - account_type = YOUTUBE_CHANNEL
  - username = @handle when available
  - external_id = YouTube channel ID
  - display_name = channel name
  - avatar_url / banner_url = channel artwork
  - url = canonical channel URL

  Used for:

  - own social accounts

  - tracked social accounts

  - game IDs

  - manually tracked accounts

  '''

}


Table external_account_relationships {

  id bigint [pk, increment]


  owner_account_id bigint [not null, ref: > external_accounts.id]


  target_account_id bigint [not null, ref: > external_accounts.id]


  follower_status follower_status

  source relationship_source [not null, default: 'MANUAL']


  follow_status follow_status [not null, default: 'UNKNOWN']


  has_liked_post boolean [not null, default: false]


  note text


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  indexes {

    (owner_account_id, target_account_id) [unique]

    follower_status

    follow_status

    source

  }

  checks {
    `owner_account_id <> target_account_id` [name: 'chk_external_relationship_not_self']
  }


  Note: '''

  Two directions are tracked separately:


  follower_status:

  Does the target follow the owner?


  follow_status:

  Does the owner follow the target?


  relationship_source records how the tracked relationship row was created.
  It is intentionally separate from follower_status so a manually added account
  can still be CURRENT_FOLLOWER, NO_LONGER_FOLLOWING, or NOT_FOLLOWING.

  Douyin primarily uses:

  FOLLOWED / NOT_FOLLOWED

  + has_liked_post.

  '''

}


Table follower_snapshots {

  id bigint [pk, increment]


  owner_account_id bigint [not null, ref: > external_accounts.id]


  captured_at timestamptz [not null]


  source follower_snapshot_source [not null]


  reported_total_count int


  imported_file_name varchar(500)


  created_at timestamptz [not null, default: `now()`]


  indexes {

    owner_account_id

    captured_at

  }

}


Table follower_snapshot_entries {

  snapshot_id bigint [not null, ref: > follower_snapshots.id]


  target_account_id bigint [not null, ref: > external_accounts.id]

  username_snapshot varchar(255)

  display_name_snapshot varchar(500)

  external_id_snapshot varchar(255)

  profile_url_snapshot varchar(2048)


  indexes {

    (snapshot_id, target_account_id) [pk]

    target_account_id

  }

}


//////////////////////////////////////////////////////////////

// FEEDS

//////////////////////////////////////////////////////////////


Table feed_sources {

  id bigint [pk, increment]


  name varchar(255) [not null]


  type feed_source_type [not null]


  source_url varchar(2048)


  feed_url varchar(2048)


  enabled boolean [not null, default: true]


  scheduled_refresh_enabled boolean [not null, default: false]


  refresh_interval_minutes int


  config jsonb


  last_fetched_at timestamptz

  next_fetch_at timestamptz


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]

  checks {
    `refresh_interval_minutes IS NULL OR refresh_interval_minutes > 0` [name: 'chk_feed_refresh_interval']
    `NOT scheduled_refresh_enabled OR refresh_interval_minutes IS NOT NULL` [name: 'chk_feed_scheduled_interval']
  }

}


Table feed_items {

  id bigint [pk, increment]


  feed_source_id bigint [not null, ref: > feed_sources.id]


  external_id varchar(500)


  title varchar(1000) [not null]


  url varchar(2048) [not null]

  url_hash varchar(64) [not null]


  author varchar(500)


  summary text


  published_at timestamptz


  fetched_at timestamptz [not null, default: `now()`]


  raw_metadata jsonb


  indexes {

    feed_source_id

    external_id

    published_at

    (feed_source_id, external_id) [unique]

    (feed_source_id, url_hash) [unique]

  }

}


//////////////////////////////////////////////////////////////

// SAVED RESOURCES / SOCIAL POSTS

//////////////////////////////////////////////////////////////


Table saved_resources {

  id bigint [pk, ref: - vault_entries.id]


  feed_item_id bigint [ref: >? feed_items.id]


  kind saved_resource_kind [not null]


  source_name varchar(500)


  source_url varchar(2048)


  external_id varchar(500)


  title varchar(1000) [not null]


  resource_url varchar(2048) [not null]

  resource_url_hash varchar(64) [not null, unique]


  author varchar(500)


  summary text


  published_at timestamptz

  fetched_at timestamptz


  saved_at timestamptz [not null, default: `now()`]


  raw_metadata jsonb


  indexes {

    kind

    title

    external_id

  }


  Note: '''

  Facebook/Instagram saved posts are represented as

  kind = SOCIAL_POST.


  Only metadata/link are stored.

  Original content remains on the source platform.

  '''

}


Table saved_resource_conversions {

  saved_resource_id bigint [not null, ref: > saved_resources.id]


  target_vault_entry_id bigint [not null, ref: > vault_entries.id]


  created_at timestamptz [not null, default: `now()`]


  indexes {

    (saved_resource_id, target_vault_entry_id) [pk]

  }


  Note: '''

  Used when a SavedResource is converted into:

  Information

  Note

  Study

  '''

}


//////////////////////////////////////////////////////////////

// IMPORT PIPELINE

//////////////////////////////////////////////////////////////


Table import_jobs {

  id bigint [pk, increment]


  target_type import_target_type [not null]


  format import_format [not null]


  original_file_name varchar(500) [not null]


  file_hash varchar(64)


  raw_file_object_key varchar(1024)


  status import_job_status [not null, default: 'CREATED']


  total_items int [not null, default: 0]

  valid_items int [not null, default: 0]

  duplicate_items int [not null, default: 0]

  invalid_items int [not null, default: 0]

  imported_items int [not null, default: 0]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]

  checks {
    `total_items >= 0` [name: 'chk_import_total_items']
    `valid_items >= 0` [name: 'chk_import_valid_items']
    `duplicate_items >= 0` [name: 'chk_import_duplicate_items']
    `invalid_items >= 0` [name: 'chk_import_invalid_items']
    `imported_items >= 0` [name: 'chk_import_imported_items']
    `valid_items <= total_items AND duplicate_items <= total_items AND invalid_items <= total_items AND imported_items <= total_items` [name: 'chk_import_counts_within_total']
    `valid_items + duplicate_items + invalid_items <= total_items` [name: 'chk_import_classified_counts_total']
  }


  Note: '''

  Import workflow:


  Upload

  -> Parse

  -> Preview

  -> Validate

  -> Duplicate/error review

  -> User selection

  -> Transactional import

  '''

}


Table import_job_items {

  id bigint [pk, increment]


  import_job_id bigint [not null, ref: > import_jobs.id]


  item_index int [not null]


  parsed_payload jsonb


  status import_item_status [not null]


  duplicate_vault_entry_id bigint [ref: >? vault_entries.id]


  error_message text


  imported_vault_entry_id bigint [ref: >? vault_entries.id]


  indexes {

    import_job_id

    (import_job_id, item_index) [unique]

  }

}


//////////////////////////////////////////////////////////////

// FINANCE

//////////////////////////////////////////////////////////////


Table wallets {

  id bigint [pk, increment]


  name varchar(255) [not null]


  type wallet_type [not null]


  currency_code varchar(3) [not null, ref: > currencies.code]


  opening_balance numeric(19,4) [not null, default: 0]


  notes text


  active boolean [not null, default: true]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  deleted_at timestamptz


  indexes {

    active

    deleted_at

  }


  Note: '''

  Current balance is derived from:


  opening_balance

  + SUM(financial_transaction_entries.amount_delta)
    for POSTED, non-deleted financial transactions only.


  Ledger data remains the source of truth.

  '''

}


Table transaction_categories {

  id bigint [pk, increment]


  name varchar(255) [not null]


  kind transaction_category_kind [not null]


  parent_category_id bigint [ref: >? transaction_categories.id]


  active boolean [not null, default: true]


  created_at timestamptz [not null, default: `now()`]


  indexes {

    parent_category_id

  }

}


Table financial_transactions {

  id bigint [pk, increment]


  type financial_transaction_type [not null]


  status financial_transaction_status [not null, default: 'POSTED']


  category_id bigint [ref: >? transaction_categories.id]


  generated_by_recurring_rule_id bigint [ref: >? recurring_transaction_rules.id]


  description varchar(1000)


  notes text


  occurred_at timestamptz [not null]


  exchange_rate numeric(24,10)


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  deleted_at timestamptz


  indexes {

    type

    status

    occurred_at

    category_id

    deleted_at

  }

  checks {
    `exchange_rate IS NULL OR exchange_rate > 0` [name: 'chk_financial_transaction_exchange_rate']
  }

}


Table financial_transaction_entries {

  id bigint [pk, increment]


  transaction_id bigint [not null, ref: > financial_transactions.id]


  wallet_id bigint [not null, ref: > wallets.id]


  amount_delta numeric(19,4) [not null]


  indexes {

    transaction_id

    wallet_id

    (transaction_id, wallet_id) [unique]

  }


  checks {
    `amount_delta <> 0` [name: 'chk_financial_entry_amount_nonzero']
  }

  Note: '''

  Positive amount adds money to a wallet.

  Negative amount removes money.


  EXPENSE:

    one negative entry


  INCOME:

    one positive entry


  TRANSFER:

    normally one negative source entry

    + one positive destination entry


  Wallet currency determines each entry currency.

  Therefore cross-currency transfers are naturally supported.

  '''

}


Table recurring_transaction_rules {

  id bigint [pk, increment]


  name varchar(500) [not null]


  transaction_type financial_transaction_type [not null]


  category_id bigint [ref: >? transaction_categories.id]


  posting_mode recurring_posting_mode [not null]


  frequency recurrence_frequency [not null]


  interval_count int [not null, default: 1]


  day_of_month int


  month_of_year int


  start_date date [not null]

  end_date date


  posting_time time


  next_run_at timestamptz


  description varchar(1000)


  notes text


  active boolean [not null, default: true]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  deleted_at timestamptz


  indexes {

    active

    next_run_at

    deleted_at

  }

  checks {
    `interval_count > 0` [name: 'chk_recurring_interval_count']
    `day_of_month IS NULL OR (day_of_month >= 1 AND day_of_month <= 31)` [name: 'chk_recurring_day_of_month']
    `month_of_year IS NULL OR (month_of_year >= 1 AND month_of_year <= 12)` [name: 'chk_recurring_month_of_year']
    `end_date IS NULL OR end_date >= start_date` [name: 'chk_recurring_date_range']
  }

}


Table recurring_rule_weekdays {

  recurring_rule_id bigint [not null, ref: > recurring_transaction_rules.id]


  weekday day_of_week [not null]


  indexes {

    (recurring_rule_id, weekday) [pk]

  }

}


Table recurring_rule_entries {

  id bigint [pk, increment]


  recurring_rule_id bigint [not null, ref: > recurring_transaction_rules.id]


  wallet_id bigint [not null, ref: > wallets.id]


  amount_delta numeric(19,4) [not null]


  indexes {

    recurring_rule_id
    wallet_id
    (recurring_rule_id, wallet_id) [unique]

  }

  checks {
    `amount_delta <> 0` [name: 'chk_recurring_entry_amount_nonzero']
  }

}


Table subscriptions {

  id bigint [pk, increment]


  name varchar(500) [not null]


  provider varchar(500)


  price_amount numeric(19,4) [not null]


  currency_code varchar(3) [not null, ref: > currencies.code]


  billing_cycle billing_cycle [not null]


  billing_interval int [not null, default: 1]

  custom_cycle_days int


  next_billing_date date


  auto_renew boolean [not null, default: true]


  payment_wallet_id bigint [ref: >? wallets.id]


  recurring_rule_id bigint [unique, ref: -? recurring_transaction_rules.id]


  url varchar(2048)


  notes text


  active boolean [not null, default: true]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  deleted_at timestamptz


  indexes {

    active

    next_billing_date

    deleted_at

  }

  checks {
    `price_amount >= 0` [name: 'chk_subscription_price']
    `billing_interval > 0` [name: 'chk_subscription_billing_interval']
    `(billing_cycle = 'CUSTOM' AND custom_cycle_days IS NOT NULL AND custom_cycle_days > 0) OR (billing_cycle <> 'CUSTOM' AND custom_cycle_days IS NULL)` [name: 'chk_subscription_custom_cycle']
  }

}


//////////////////////////////////////////////////////////////

// DIARY

//////////////////////////////////////////////////////////////


Table diary_entries {

  id bigint [pk, increment]


  entry_date date [not null]


  title varchar(500)


  content_markdown text [not null]


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  deleted_at timestamptz


  indexes {

    entry_date

    deleted_at

  }


  Note: 'Multiple diary entries per calendar day are allowed.'

}


//////////////////////////////////////////////////////////////

// PERSONAL / FAMILY INFORMATION

//////////////////////////////////////////////////////////////


Table personal_profiles {

  id bigint [pk, increment]


  name varchar(255) [not null]


  relationship varchar(100) [not null]


  is_self boolean [not null, default: false]


  gender gender


  birth_date date


  nationality_code varchar(2) [ref: >? countries.code]


  phone varchar(64)


  email varchar(320)


  address_id bigint [ref: >? addresses.id]


  occupation varchar(255)


  notes_markdown text


  created_at timestamptz [not null, default: `now()`]

  updated_at timestamptz [not null, default: `now()`]


  deleted_at timestamptz


  indexes {

    name

    relationship

    deleted_at

  }

}


//////////////////////////////////////////////////////////////

// FROZEN V1 IMPLEMENTATION NOTES

//////////////////////////////////////////////////////////////

// The logical ERD is frozen at this revision.
// PostgreSQL/Flyway implementation must additionally enforce:
// - case-insensitive uniqueness where required (email, username, tag/taxonomy names);
// - subtype consistency between vault_entries.entry_type and each subtype table;
// - capability rules for favorites, ratings, and tags by vault entry type;
// - only one non-deleted personal_profiles row with is_self = true;
// - same-platform/type validation for external account relationships and YouTube study links;
// - finance transaction shape/sign rules (INCOME, EXPENSE, TRANSFER) and category compatibility;
// - recurring schedule field compatibility by frequency;
// - soft-delete dependency consistency (for example Study -> YouTube account, Location -> Brand);
// - hard-delete referential actions after Recycle Bin permanent deletion;
// - pg_trgm/search indexes required by the global search implementation.


//////////////////////////////////////////////////////////////

// TABLE GROUPS

//////////////////////////////////////////////////////////////


TableGroup Authentication {

  app_users

  refresh_tokens

  app_settings

}


TableGroup Core {

  vault_entries

  favorites

  ratings

  tags

  vault_entry_tags

  countries

  languages

  currencies

  platforms

}


TableGroup People {

  persons

  person_roles

  creator_groups

  creator_group_members

}


TableGroup FictionFilm {

  fiction_genres

  film_genres

  story_archetypes

  world_settings

  fictions

  fiction_story_archetypes

  fiction_world_settings

  fiction_links

  films

  film_genre_assignments

  film_story_archetypes

  film_world_settings

  film_links

  film_credits

}


TableGroup MediaLocation {

  albums

  images

  brands

  location_categories

  addresses

  locations

  location_category_assignments

  location_dining_service_styles

  location_business_hours

}


TableGroup Knowledge {

  study_items

  information_items

  vocabulary_items

  vocabulary_reviews

  notes

}


TableGroup Library {

  music_tracks

  music_track_people

  shopping_items

  software_items

  software_item_platforms

}


TableGroup ExternalData {

  external_accounts

  external_account_relationships

  follower_snapshots

  follower_snapshot_entries

  feed_sources

  feed_items

  saved_resources

  saved_resource_conversions

}


TableGroup Importing {

  import_jobs

  import_job_items

}


TableGroup Finance {

  wallets

  transaction_categories

  financial_transactions

  financial_transaction_entries

  recurring_transaction_rules

  recurring_rule_weekdays

  recurring_rule_entries

  subscriptions

}


TableGroup Personal {

  diary_entries

  personal_profiles

}

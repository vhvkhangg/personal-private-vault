// GDI26-S2 additive metadata only; V26 is physical authority. V1/V25 remain unchanged.
Table drive_folder_roots {
  google_sub varchar(255) [pk, not null, note: 'Verified nonblank Google subject; no connection/slot FK']
  root_file_id varchar(255) [not null, unique, note: 'ASCII provider ID, 1..112 characters for ppvCreatedId property capacity']
  root_binding_id uuid [not null, unique]
  status varchar(32) [not null, note: 'CHECK PENDING / READY / RECONCILIATION_REQUIRED']
  binding_epoch uuid [not null, unique, note: 'Random equality-CAS generation; not monotonic']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (google_sub, root_binding_id) [unique] }
}

Table drive_upload_intents {
  google_sub varchar(255) [not null]
  root_binding_id uuid [not null]
  idempotency_key varchar(53) [not null, unique, note: 'Strict UTC timestamp + lowercase UUIDv4; globally unique across roots/subjects']
  request_fingerprint char(64) [not null, note: 'CHECK lowercase 64-hex SHA-256']
  content_md5 char(32) [not null, note: 'CHECK lowercase 32-hex MD5 for original-byte reconciliation']
  size_bytes bigint [not null, note: 'CHECK 0..52428800']
  safe_name varchar(255) [not null, note: 'CHECK UTF-8 byte length 1..255; application normalizes NFC and rejects unsafe paths/controls']
  mime_type varchar(127) [not null, note: 'CHECK lowercase ASCII base MIME syntax']
  provider_file_id varchar(255) [null, unique, note: 'Bound once; ASCII 1..112, never reallocated after dispatch']
  status varchar(32) [not null, note: 'CHECK PREPARING / RESERVED / DISPATCHED / RECONCILIATION_REQUIRED / COMPLETED / FAILED_DEFINITIVE']
  intent_epoch uuid [not null, unique]
  root_binding_epoch uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  completed_at timestamptz [null, note: 'Required exactly for terminal COMPLETED/FAILED_DEFINITIVE']
  indexes { (google_sub, root_binding_id, idempotency_key) [pk] }
  Note: '''
  PREPARING requires NULL provider_file_id; RESERVED/DISPATCHED/RECONCILIATION_REQUIRED/COMPLETED require it.
  FAILED_DEFINITIVE permits either. Fingerprint/metadata/provider identity are immutable through application CAS paths.
  Both relations excluded from Portability; no bytes, token, encryption key or resumable session URL.
  Root-row lock bounds admission to 8 nonterminal/1024 retained actions; prune at most 32 terminal rows older than 30 days.
  No cascade deletion on disconnect, no whole-file catalog, no native database enums.
  '''
}
Ref: drive_upload_intents.(google_sub, root_binding_id) > drive_folder_roots.(google_sub, root_binding_id)

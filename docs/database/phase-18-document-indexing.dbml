// RR-01-03 2026-10-22: no migration/schema/grant changes.
// Existing rag.runs.metrics operational JSON carries cancel_requested=true,
// committed under the active lease guard before process shutdown; terminal
// finish reads durable intent. Public status/contract and C_P remain unchanged.
// docs/implementation/phase-18/slice-3-rr-corrective-handback-2026-10-22.md.
// D24 2026-10-21: overall Phase 18 external input is Obsidian Markdown .md only.
// Current corrective candidate 2026-10-21: V22__rag_document_result_authority.sql
// adds no tables/columns/enums. Existing RAG functions/grants/triggers protect
// ordered actual-result seals, nonterminal document evidence and typed UUID dependencies.
// worker_identity JSON may bind one suspended DB-credential-free verifier;
// generation JSON carries original input and post-selection manifests/result digest.
// Captured basename and optional sorted lexical suffix hashes are in the managed
// file manifest, independently bound with canonical-path SHA-256 in existing
// sources.file_identity (64+64 hex, no raw path). Legacy naming proofs are retained.
// 2026-10-22 final checkpoint adds no migration/schema/grant. Execution evidence:
// docs/implementation/phase-18/slice-3-final-corrective-handback-2026-10-22.md.
// Implementation evidence is ready for independent re-review, not accepted publication/FR18-3 closure.
// See docs/implementation/phase-18/slice-3-codex-corrective-handback-2026-10-21.md.
// Format applicability and planned end-Slice-4 cleanup: docs/implementation/phase-18/slice-3-markdown-scope-and-baseline-2026-10-21.md.
// D24 preparation inspected V21; V22 is the current unaccepted corrective candidate above.
// 2026-10-19 OWNER AMENDMENT: ADR-0023 supersedes old OS-native G1/G3
// requirements (Restricted Token/LPAC/DACL/ABA/forensic proofs). Java-owned
// application snapshot: selected regular file, streamed SHA-256+length,
// no-overwrite R, integrity before use and bounded crash/orphan recovery.
// Keep SQL source guards, result checks, one trusted C_P and whole-file consent.
// This is logical mapping, NOT a new migration or runtime PASS.
// Phase 18 candidate physical schema: V18/V19 plus closed Slice 1 V20/V21 and unaccepted Slice 3 V22.
// Slice 1 is CLOSED under D14; Slice 3 final corrective evidence awaits independent re-review.
// Pending snapshots/whole-file approval are exposed; external indexing INACTIVE.
// Selected-R/sourceVersion/G promotion is Slice 3 candidate behavior; final NO_CHANGE remains unimplemented here.
// Appends to frozen Schema v1 and Phase 17 additive DBML without modifying frozen baselines.
// Mixed-source lock order (ADR-0021 clause 2): optional graph barrier -> sorted Vault
// source-state guards -> sorted RAG external-file source guards -> Vault lifecycle
// -> owner projection/assignment -> sorted RAG policy -> job/attempt ->
// generation/staging/run. Preserves preexisting Phase 17 order.
Project phase18_rag_document_index {
  database_type: 'PostgreSQL'
  Note: 'RAG-owned candidate additions in V18-V21 migrations. Extends rag schema with multi-root batch admission, per-file reporting, generation roots, document chunks with vector(384), and stage fences.'
}

// ADR-0022 additive logical responsibility map (TARGET / NOT_IMPLEMENTED):
// O = private original provenance/root/object/ancestors and capture interval;
// S = distinct RAG-owned logical snapshot identity, never Vault/hash identity;
// R = immutable ORIGINAL_BYTES UUID/ordinal, SHA-256 + length, durable protected
// app-level no-overwrite file-side seal outside PG, exact child-vector/manifest and approval;
// G = exact verified generation for its own S/R/closure, not the batch union.
// Separate sourceVersion, source reset/authorization, revision grant/consent-mode
// policy and monotonic incident fence/disposition; selected R versus pending R.
// WHOLE_FILE replaces external internal-field privacy permission; structural roles
// remain attribution. Every independently opened child retains its own S/R/grant.
// Valid NO_CHANGE changes no R/ordinal/sourceVersion/G/consent/selection/closure;
// no new job enum. Full mixed roster/union survives to known final atomic finish.
// C_N = guarded NO_CHANGE nonpublication disposition; implement C_D-like deny
// via minimal durable source-integrity state using existing Phase 17 guards;
// C_R = actual cancel-first revoke/reset; C_P = one trusted Java new-G publication.
// Source-first same-transaction guards and exact release remain mandatory; unknown
// outcomes retain exclusion/reservations. No hash-only authority or producer proof.
// Snapshot CURRENT target = SNAPSHOT_CURRENT, originalFreshness=UNVERIFIED;
// source/consent/selected child/integrity/incident/retention predicates all required.
// Locator JSON target adds typed original container-part/property-key/object/comment
// IDs for genuinely non-page/cell-located material, with S/R/digest/applicable anchor;
// actual page/box/cell/paragraph/merged-cell geometry remains mandatory.
// Purge targets complete managed snapshots/temp/orphans and actual SQL derivatives;
// preserve safe reset/incident/anti-replay history. Managed file backup exclusions
// do not erase PG backups/WAL/owner copies. Missing files/uncertain restore denies.
// Minimal physical reconciliation/append-only migrations require separate approved
// implementation and review after actual tip V21; do not rewrite V1-V19/Schema v1.
// See docs/adr/0022-phase-18-immutable-snapshot-whole-file-consent-no-change.md,
// docs/architecture/rag-phase-18-api-extension.md and Phase 18 AC/FCNC evidence.

Table rag.external_file_sources {
  id bigserial [pk]
  file_source_id uuid [unique, not null, note: 'Stable RAG-owned external file identity; NEVER cast to Vault ID']
  canonical_identity_digest varchar(128) [not null, note: 'No raw private path in operational report']
  source_version bigint [not null, default: 1]
  consent_reset_version bigint [not null, default: 1]
  authorization_epoch bigint [not null, default: 1]
  field_policy_version int [not null, default: 1]
  eligible boolean [not null, default: true]
  reserved_by uuid [note: 'Durable exact job reservation, no TTL/unverified release']
  // V20 pending-only revision and expected selection metadata.
  selected_revision_id uuid
  pending_revision_id uuid
  pending_revision_hash varchar(128)
  pending_byte_length bigint
  pending_sealed_at timestamptz
  expected_selected_revision_id uuid
  expected_source_version bigint
  // V21 correction: independently trusted selected descriptor, exact pending consent, durable denial.
  selected_revision_hash varchar(128)
  selected_byte_length bigint
  approved_pending_revision_id uuid [note: 'Exact whole-file-approved pending R; cleared on replacement']
  pending_consent_context varchar(160) [note: 'Captured policy/reset/authorization tuple, no content or locator']
  snapshot_integrity_failed boolean [not null, default: false, note: 'Deny until explicit owner recovery; never hash-repaired']
  created_at timestamptz [not null, default: `clock_timestamp()`]
  updated_at timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Guarded by trg_external_file_sources_guard trigger against mutation while reserved.'
}

Table rag.batch_roots {
  job_id uuid [not null]
  root_key varchar(255) [not null, note: 'Tagged source identity: Vault-backed or RAG external; not a raw path']
  source_id bigint [not null, ref: > rag.sources.id, note: 'FK to rag.sources']
  expected_source_version bigint [not null]
  expected_authorization_epoch bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Immutable explicit batch root admission set; each root independently approved.'
  indexes { (job_id, root_key) [pk] }
}

Table rag.file_outcomes {
  job_id uuid [not null]
  root_key varchar(255) [not null]
  result varchar(32) [not null, note: 'Per-file outcome: SUCCESS or FAILED']
  candidate_generation_id uuid [note: 'Generation UUID when published']
  warning_codes jsonb [not null, default: `'[]'`, note: 'Safe non-content reason codes']
  chunk_count int [not null, default: 0]
  page_count int [not null, default: 0]
  error_code varchar(64) [note: 'Sanitized failure code']
  error_message text [note: 'Sanitized error detail']
  created_at timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Durable per-file outcome. Computed live validity (CURRENT/REVOKED/OUTDATED) evaluated dynamically at query time.'
  indexes { (job_id, root_key) [pk] }
}

Table rag.generation_roots {
  generation_id bigint [pk, ref: > rag.index_generations.id, note: 'One-to-one with index_generations for published root']
  root_key varchar(255) [not null]
  exact_dependency_manifest jsonb [not null, note: 'manifest_text contains this generation own exact domain root/child/edge/field/version/reset proof, independent of the job union; external authority incomplete']
  model_artifact_hash varchar(128) [not null]
  model_version varchar(128) [not null]
  tokenizer_version varchar(128) [not null]
  parser_version varchar(128) [not null]
  chunker_version varchar(128) [not null]
  ocr_pipeline_version varchar(128) [not null]
  vector_dimensions int [not null, note: 'Enforced 384 dimensions']
  created_at timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Per-generation metadata for independent CURRENT/OUTDATED/revocation/purge lifetime.'
}

Table rag.document_chunks {
  chunk_id bigserial [pk]
  generation_id bigint [not null, ref: > rag.generation_roots.generation_id]
  source_identity varchar(255) [not null, note: 'Exact approved attributed original source']
  content text [not null, note: 'Sensitive derived content; purged on revocation']
  locator jsonb [not null, note: 'Format-specific typed provenance (PDF page/bbox, Excel worksheet/a1_range, DOCX para/table, MD line_start)']
  structure_metadata jsonb [not null, default: `'{}'`, note: 'Allowlisted structural elements']
  embedding vector(384) [note: 'Hibernate float[] / SqlTypes.VECTOR with BOM-aligned hibernate-vector; V19 rejects absent extension or BYTEA installation without deleting data']
  created_at timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Atomic published content lifecycle fenced by worker deadline trigger and trusted Java transaction.'
}

Table rag.staged_document_outputs {
  id bigserial [pk]
  job_id uuid [not null]
  attempt_id uuid [not null]
  root_key varchar(255) [not null]
  success boolean [not null]
  reason_code varchar(64) [not null]
  warning_codes jsonb [not null, default: `'[]'`]
  chunks_payload jsonb [not null, default: `'[]'`]
  resource_report jsonb [not null, default: `'{}'`]
  worker_receipt boolean [not null, default: true]
  created_at timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Restricted worker staging table protected by trg_staged_document_outputs_lease_fence commit stage deadline constraint trigger.'
  indexes {
    (job_id, attempt_id, root_key) [unique]
  }
}

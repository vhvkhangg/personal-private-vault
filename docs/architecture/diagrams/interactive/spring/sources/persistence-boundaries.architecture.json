  "cards": [
    {
      "dot": "cyan",
      "title": "Metadata operation",
      "items": [
        "ImageService validates, creates a Vault identity through the public facade, then saves image metadata.",
        "Default REQUIRED propagation joins Vault creation to the metadata transaction. Repositories remain owner-local."
      ]
    },
    {
      "dot": "rose",
      "title": "Upload operation · compensation",
      "items": [
        "Upload rejects an ambient transaction. Storage precedes the separate metadata transaction.",
        "Confirmed rollback deletes the attempt object with at most three tries. An uncertain commit is reconciled; unknown outcomes retain the object."
      ]
    },
    {
      "dot": "amber",
      "title": "Optional storage",
      "items": [
        "Disabled adapter is the default. Enabled configuration selects the S3-compatible adapter; deployment is not asserted.",
        "Binary bytes stay in object storage; PostgreSQL holds metadata. No distributed transaction is claimed."
      ]
    },
    {
      "dot": "emerald",
      "title": "Portability operation",
      "items": [
        "One explicit read-only JDBC REPEATABLE READ connection reads an allowlist and writes a local ZIP.",
        "It commits or rolls back that database snapshot. Flyway owns schema creation; Hibernate validates it."
      ]
    }
  ]

  "cards": [
    {
      "dot": "cyan",
      "title": "Independent API operations",
      "items": [
        "All route labels use the /api/v1 prefix. Bootstrap/login/refresh/revoke are explicitly public routes.",
        "A successful bootstrap inserts the singleton with hashed password and PIN through a REQUIRES_NEW helper; duplicate bootstrap is 409."
      ]
    },
    {
      "dot": "emerald",
      "title": "Token lifecycle",
      "items": [
        "Login validates the stored password hash. Refresh stores only SHA-256 hashes and expiry; raw refresh values are returned in JSON.",
        "Rotation locks the predecessor and atomically saves its successor/replacement. Invalid, expired, replaced or revoked refresh tokens produce 401."
      ]
    },
    {
      "dot": "rose",
      "title": "Revocation and PIN limits",
      "items": [
        "Revocation concerns the supplied refresh token; an issued JWT remains valid until its own validation/expiry rejects it.",
        "PIN verification returns a boolean; it creates no unlock session. PIN changes require authenticated context and the current PIN."
      ]
    },
    {
      "dot": "amber",
      "title": "Client policy is future work",
      "items": [
        "Token response type is Bearer. No cookie, browser persistence, inactivity timer or delivered frontend policy is asserted.",
        "These source-derived scenarios are not a measured trace. Grouped services keep their own transaction annotations."
      ]
    }
  ]
}

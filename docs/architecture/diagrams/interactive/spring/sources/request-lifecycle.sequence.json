  "cards": [
    {
      "dot": "cyan",
      "title": "Successful read",
      "items": [
        "Controller → ImageOperations → ImageService → owner-local repository.",
        "The service returns ImageView; the controller maps it to ImageResponse in the shared data/error/meta envelope."
      ]
    },
    {
      "dot": "rose",
      "title": "Denied and error paths",
      "items": [
        "401 stops before the controller. The missing-row alternative starts after the same repository lookup.",
        "Spring MVC dispatch and JPA row loading are framework-inferred steps supported by project configuration, not a measured trace."
      ]
    },
    {
      "dot": "emerald",
      "title": "Transaction scope",
      "items": [
        "Only ImageService.findById is marked read-only here. The HTTP request has no invented global transaction.",
        "This is a metadata read; binary transfer is a separate endpoint."
      ]
    }
  ]

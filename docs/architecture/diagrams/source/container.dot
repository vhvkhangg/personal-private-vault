digraph C4Container {
 graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.7, ranksep=1.0, splines=ortho, label="Personal Private Vault — C4 Container", labelloc=t, fontsize=20, fontname="Arial Bold"];
 node [shape=box, style="rounded,filled", fontname="Arial", margin="0.18,0.12"];
 edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];
 owner [label="Owner", fillcolor="#08427B", fontcolor="white", color="#06345F"];
 subgraph cluster_vault {
   label="Personal Private Vault"; color="#1168BD"; penwidth=2; style="rounded"; fontname="Arial Bold"; fontsize=14;
   web [label="Web Application

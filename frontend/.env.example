# PPV Spring backend origin (default http://localhost:8080, fixture uses http://localhost:19080)
PPV_SPRING_ORIGIN=http://localhost:8080

# Isolated test fixture flag (0 in normal product, 1 in local automated test fixture)
PPV_H1F_TEST_FIXTURE=0

# Owner setup enabled flag (default false, true only for one-time owner setup pilot)
PPV_OWNER_SETUP_ENABLED=false

# Public OAuth client IDs must exactly match the separately configured Spring clients.
# Never put client secrets here. Missing IDs fail closed at authorization validation.
PPV_GOOGLE_SIGNIN_CLIENT_ID=
PPV_DRIVE_CLIENT_ID=
